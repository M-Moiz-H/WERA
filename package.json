"scripts": {
  "dev:api": "npm --workspace @wera/api run dev",
  "build": "npm run build:client && npm run build:api",
  "build:client": "npm --workspace @wera/warera-client run build",
  "build:api": "npm --workspace @wera/api run build",
  "start": "npm --workspace @wera/api run start",
  "typecheck": "npm run typecheck:client && npm run typecheck:api",
  "typecheck:client": "npm --workspace @wera/warera-client run typecheck",
  "typecheck:api": "npm --workspace @wera/api run typecheck"
}
